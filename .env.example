# LLM endpoint (any OpenAI-compatible API; Groq by default, or Ollama at http://localhost:11434/v1)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-groq-key

# Langfuse (self-hosted via `make langfuse-up`, or cloud). When both keys are set, every trace is
# exported over OTLP to $LANGFUSE_HOST/api/public/otel; otherwise traces stay in traces/*.jsonl.
LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-local-dev
# LANGFUSE_SECRET_KEY=sk-lf-local-dev

# Or any OTLP/HTTP collector (Jaeger, Tempo, OTel Collector):
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Override observability.yaml keys: RAGOBS__<SECTION>__<KEY>=value, e.g.
# RAGOBS__RAG__MODEL=openai/gpt-oss-20b
